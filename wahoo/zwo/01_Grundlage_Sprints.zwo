    <SteadyState Duration="290" Power="0.58"><textevent timeoffset="0" message="locker 1/6"/></SteadyState>
    <SteadyState Duration="10" Power="1.60"><textevent timeoffset="0" message="Sprint 2/6"/></SteadyState>
    <SteadyState Duration="290" Power="0.58"><textevent timeoffset="0" message="locker 2/6"/></SteadyState>
