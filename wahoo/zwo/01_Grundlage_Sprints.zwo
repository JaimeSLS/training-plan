<workout_file>
  <author>Training Plan</author>
  <name>Grundlage Sprints</name>
  <description>Lockere Grundlage (Z2) mit 6 kurzen Sprints zum Wachwerden der Beine. Sprints: 10 s maximal aus ca. 80-90 rpm, dazwischen locker rollen.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
