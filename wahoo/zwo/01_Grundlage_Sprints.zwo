    <SteadyState Duration="290" Power="0.58"><textevent timeoffset="0" message="locker 3/6"/></SteadyState>
    <SteadyState Duration="10" Power="1.60"><textevent timeoffset="0" message="Sprint 4/6"/></SteadyState>
    <SteadyState Duration="290" Power="0.58"><textevent timeoffset="0" message="locker 4/6"/></SteadyState>
    <SteadyState Duration="10" Power="1.60"><textevent timeoffset="0" message="Sprint 5/6"/></SteadyState>
