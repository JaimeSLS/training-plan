    <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.75"/>
    <SteadyState Duration="3600" Power="0.68"><textevent timeoffset="0" message="Z2 Grundlage"/></SteadyState>
    <SteadyState Duration="360" Power="0.85"><textevent timeoffset="0" message="Tempo 1/3"/></SteadyState>
    <SteadyState Duration="240" Power="0.62"><textevent timeoffset="0" message="locker 1/3"/></SteadyState>
    <SteadyState Duration="360" Power="0.85"><textevent timeoffset="0" message="Tempo 2/3"/></SteadyState>
    <SteadyState Duration="240" Power="0.62"><textevent timeoffset="0" message="locker 2/3"/></SteadyState>
    <SteadyState Duration="360" Power="0.85"><textevent timeoffset="0" message="Tempo 3/3"/></SteadyState>
    <SteadyState Duration="240" Power="0.62"><textevent timeoffset="0" message="locker 3/3"/></SteadyState>
    <SteadyState Duration="2700" Power="0.67"><textevent timeoffset="0" message="Z2 Grundlage"/></SteadyState>
    <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45"/>
  </workout>
