<workout_file>
  <author>Training Plan</author>
  <name>Grundlage Antritte 90</name>
  <description>90 min Z2 mit 6 kurzen Antritten (15 s zuegig, nicht maximal) - weckt die Spritzigkeit fuer die Gruppe, ohne zu ermueden. Nach einem harten Padel-Tag die Antritte weglassen und nur Grundlage fahren.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.75"/>
    <SteadyState Duration="1800" Power="0.68"><textevent timeoffset="0" message="Z2 Grundlage"/></SteadyState>
    <SteadyState Duration="15" Power="1.30"><textevent timeoffset="0" message="Antritt 1/6"/></SteadyState>
    <SteadyState Duration="165" Power="0.60"><textevent timeoffset="0" message="locker 1/6"/></SteadyState>
    <SteadyState Duration="15" Power="1.30"><textevent timeoffset="0" message="Antritt 2/6"/></SteadyState>
    <SteadyState Duration="165" Power="0.60"><textevent timeoffset="0" message="locker 2/6"/></SteadyState>
    <SteadyState Duration="15" Power="1.30"><textevent timeoffset="0" message="Antritt 3/6"/></SteadyState>
    <SteadyState Duration="165" Power="0.60"><textevent timeoffset="0" message="locker 3/6"/></SteadyState>
    <SteadyState Duration="15" Power="1.30"><textevent timeoffset="0" message="Antritt 4/6"/></SteadyState>
    <SteadyState Duration="165" Power="0.60"><textevent timeoffset="0" message="locker 4/6"/></SteadyState>
    <SteadyState Duration="15" Power="1.30"><textevent timeoffset="0" message="Antritt 5/6"/></SteadyState>
    <SteadyState Duration="165" Power="0.60"><textevent timeoffset="0" message="locker 5/6"/></SteadyState>
    <SteadyState Duration="15" Power="1.30"><textevent timeoffset="0" message="Antritt 6/6"/></SteadyState>
    <SteadyState Duration="165" Power="0.60"><textevent timeoffset="0" message="locker 6/6"/></SteadyState>
    <SteadyState Duration="1620" Power="0.68"><textevent timeoffset="0" message="Z2 Grundlage"/></SteadyState>
    <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45"/>
  </workout>
</workout_file>
