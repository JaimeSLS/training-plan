<workout_file>
  <author>Training Plan</author>
  <name>Tempo 3x10</name>
  <description>3 x 10 min Tempo @ 83 % FTP, 5 min locker dazwischen, 80-90 rpm. Letzte Radeinheit vor der Abreise - danach haben die Beine bis Sonntag Zeit, sich zu erholen. Sind sie nach Montag noch schwer: nur 2 x 10 min.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.75"/>
    <SteadyState Duration="300" Power="0.65"><textevent timeoffset="0" message="Z2"/></SteadyState>
    <SteadyState Duration="600" Power="0.83"><textevent timeoffset="0" message="Tempo 80-90 rpm 1/3"/></SteadyState>
    <SteadyState Duration="300" Power="0.58"><textevent timeoffset="0" message="locker 1/3"/></SteadyState>
    <SteadyState Duration="600" Power="0.83"><textevent timeoffset="0" message="Tempo 80-90 rpm 2/3"/></SteadyState>
    <SteadyState Duration="300" Power="0.58"><textevent timeoffset="0" message="locker 2/3"/></SteadyState>
    <SteadyState Duration="600" Power="0.83"><textevent timeoffset="0" message="Tempo 80-90 rpm 3/3"/></SteadyState>
    <SteadyState Duration="300" Power="0.58"><textevent timeoffset="0" message="locker 3/3"/></SteadyState>
    <SteadyState Duration="300" Power="0.65"><textevent timeoffset="0" message="Z2"/></SteadyState>
    <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45"/>
  </workout>
</workout_file>
