<workout_file>
  <author>Training Plan</author>
  <name>VO2max Attacken 5x3</name>
  <description>5 x 3 min @ 112 % FTP, 3 min Pause. Fuer die Momente, in denen die Gruppe am Suikerbossie oder an Chapman's anzieht. Wegen der Radpause bewusst etwas unter dem ueblichen Niveau (112 statt 118 %).</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="720" PowerLow="0.50" PowerHigh="0.75"/>
    <SteadyState Duration="30" Power="1.10"><textevent timeoffset="0" message="Openers 1/3"/></SteadyState>
    <SteadyState Duration="30" Power="0.55"><textevent timeoffset="0" message="locker 1/3"/></SteadyState>
    <SteadyState Duration="30" Power="1.10"><textevent timeoffset="0" message="Openers 2/3"/></SteadyState>
    <SteadyState Duration="30" Power="0.55"><textevent timeoffset="0" message="locker 2/3"/></SteadyState>
    <SteadyState Duration="30" Power="1.10"><textevent timeoffset="0" message="Openers 3/3"/></SteadyState>
    <SteadyState Duration="30" Power="0.55"><textevent timeoffset="0" message="locker 3/3"/></SteadyState>
    <SteadyState Duration="240" Power="0.55"><textevent timeoffset="0" message="locker"/></SteadyState>
    <SteadyState Duration="180" Power="1.12"><textevent timeoffset="0" message="VO2max 1/5"/></SteadyState>
    <SteadyState Duration="180" Power="0.50"><textevent timeoffset="0" message="Pause 1/5"/></SteadyState>
    <SteadyState Duration="180" Power="1.12"><textevent timeoffset="0" message="VO2max 2/5"/></SteadyState>
    <SteadyState Duration="180" Power="0.50"><textevent timeoffset="0" message="Pause 2/5"/></SteadyState>
    <SteadyState Duration="180" Power="1.12"><textevent timeoffset="0" message="VO2max 3/5"/></SteadyState>
    <SteadyState Duration="180" Power="0.50"><textevent timeoffset="0" message="Pause 3/5"/></SteadyState>
    <SteadyState Duration="180" Power="1.12"><textevent timeoffset="0" message="VO2max 4/5"/></SteadyState>
    <SteadyState Duration="180" Power="0.50"><textevent timeoffset="0" message="Pause 4/5"/></SteadyState>
    <SteadyState Duration="180" Power="1.12"><textevent timeoffset="0" message="VO2max 5/5"/></SteadyState>
    <SteadyState Duration="180" Power="0.50"><textevent timeoffset="0" message="Pause 5/5"/></SteadyState>
    <SteadyState Duration="600" Power="0.65"><textevent timeoffset="0" message="Z2"/></SteadyState>
    <Cooldown Duration="360" PowerLow="0.55" PowerHigh="0.45"/>
  </workout>
</workout_file>
