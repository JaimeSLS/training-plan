<workout_file>
  <author>Training Plan</author>
  <name>Kapstadt Ankommen 60</name>
  <description>Nach der Anreise die Beine lockern und schauen, ob am Rad alles passt (Schaltung, Bremsen, Sattelhoehe nach dem Transport). Ganz locker, mit 3 x 1 min hoher Trittfrequenz.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.58"/>
    <SteadyState Duration="900" Power="0.60"><textevent timeoffset="0" message="locker"/></SteadyState>
    <SteadyState Duration="60" Power="0.62"><textevent timeoffset="0" message="TF 100-110 rpm 1/3"/></SteadyState>
    <SteadyState Duration="240" Power="0.60"><textevent timeoffset="0" message="locker 1/3"/></SteadyState>
    <SteadyState Duration="60" Power="0.62"><textevent timeoffset="0" message="TF 100-110 rpm 2/3"/></SteadyState>
    <SteadyState Duration="240" Power="0.60"><textevent timeoffset="0" message="locker 2/3"/></SteadyState>
    <SteadyState Duration="60" Power="0.62"><textevent timeoffset="0" message="TF 100-110 rpm 3/3"/></SteadyState>
    <SteadyState Duration="240" Power="0.60"><textevent timeoffset="0" message="locker 3/3"/></SteadyState>
    <SteadyState Duration="1200" Power="0.60"><textevent timeoffset="0" message="locker"/></SteadyState>
    <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45"/>
  </workout>
</workout_file>
