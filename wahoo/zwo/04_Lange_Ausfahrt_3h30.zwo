<workout_file>
  <author>Training Plan</author>
  <name>Lange Ausfahrt 3h30</name>
  <description>Generalprobe fuer die Sonntagsrunde: 3:30 h Z2 mit 2 x 12 min Sweet Spot (am besten an einem Anstieg). 60-80 g Kohlenhydrate/h, alle 15-20 min trinken. Draussen fahren, der ROAM zeigt dir die Zielbereiche.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.75"/>
    <SteadyState Duration="4500" Power="0.68"><textevent timeoffset="0" message="Z2 Grundlage"/></SteadyState>
    <SteadyState Duration="720" Power="0.88"><textevent timeoffset="0" message="SS Anstieg 1"/></SteadyState>
    <SteadyState Duration="600" Power="0.63"><textevent timeoffset="0" message="Z2 locker"/></SteadyState>
    <SteadyState Duration="720" Power="0.88"><textevent timeoffset="0" message="SS Anstieg 2"/></SteadyState>
    <SteadyState Duration="4500" Power="0.67"><textevent timeoffset="0" message="Z2 Grundlage"/></SteadyState>
    <Cooldown Duration="660" PowerLow="0.60" PowerHigh="0.45"/>
  </workout>
</workout_file>
