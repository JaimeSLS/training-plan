<workout_file>
  <author>Training Plan</author>
  <name>30-30 Starts</name>
  <description>3 Start-Sprints (15 s, aus niedriger TF wie beim Rennstart), danach 2 x 8 x (30 s @ 130 % / 30 s @ 50 %). Rennspezifisch, aber kurz - gut als letzter harter Reiz vor dem Saisoneinstieg.</description>
  <sportType>bike</sportType>
  <tags/>
