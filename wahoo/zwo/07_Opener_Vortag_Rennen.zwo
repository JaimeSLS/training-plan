<workout_file>
  <author>Training Plan</author>
  <name>Opener Vortag Rennen</name>
  <description>Kurzer Opener fuer den Tag vor dem ersten Rennen: locker mit 3 x 1 min @ 105 % und 3 kurzen Sprints. Soll frisch machen, nicht muede.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.75"/>
    <SteadyState Duration="600" Power="0.65"><textevent timeoffset="0" message="Z2"/></SteadyState>
    <SteadyState Duration="60" Power="1.05"><textevent timeoffset="0" message="Opener 1/3"/></SteadyState>
    <SteadyState Duration="120" Power="0.55"><textevent timeoffset="0" message="locker 1/3"/></SteadyState>
    <SteadyState Duration="60" Power="1.05"><textevent timeoffset="0" message="Opener 2/3"/></SteadyState>
    <SteadyState Duration="120" Power="0.55"><textevent timeoffset="0" message="locker 2/3"/></SteadyState>
    <SteadyState Duration="60" Power="1.05"><textevent timeoffset="0" message="Opener 3/3"/></SteadyState>
    <SteadyState Duration="120" Power="0.55"><textevent timeoffset="0" message="locker 3/3"/></SteadyState>
    <SteadyState Duration="10" Power="1.50"><textevent timeoffset="0" message="Sprint 1/3"/></SteadyState>
    <SteadyState Duration="110" Power="0.55"><textevent timeoffset="0" message="locker 1/3"/></SteadyState>
    <SteadyState Duration="10" Power="1.50"><textevent timeoffset="0" message="Sprint 2/3"/></SteadyState>
    <SteadyState Duration="110" Power="0.55"><textevent timeoffset="0" message="locker 2/3"/></SteadyState>
    <SteadyState Duration="10" Power="1.50"><textevent timeoffset="0" message="Sprint 3/3"/></SteadyState>
    <SteadyState Duration="110" Power="0.55"><textevent timeoffset="0" message="locker 3/3"/></SteadyState>
    <SteadyState Duration="300" Power="0.62"><textevent timeoffset="0" message="Z2"/></SteadyState>
    <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45"/>
  </workout>
</workout_file>
